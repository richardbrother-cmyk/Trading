# Copia este archivo a .env y rellena tus claves de Alpaca PAPER (https://app.alpaca.markets/paper/dashboard/overview)
# El bot se niega a arrancar si la URL no es la de paper trading.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Broker: "sim" (simulador local, no requiere claves) o "alpaca" (paper trading real)
BROKER=sim
# Fuente de datos: "yahoo" (sin claves), "alpaca" (requiere claves) o "synthetic" (datos generados)
DATA_PROVIDER=yahoo

# Universo y parametros de la estrategia
SYMBOLS=SPY,QQQ,AAPL,MSFT,NVDA,GLD,SLV,PPLT,PALL,USO,WEAT,CORN,DBA
FAST_SMA=20
SLOW_SMA=50
RSI_PERIOD=14
RSI_MAX_ENTRY=70

# Gestion de riesgo
INITIAL_CASH=100000
RISK_PER_TRADE=0.02
MAX_POSITIONS=10
MAX_POSITION_PCT=0.12
MAX_DAILY_LOSS_PCT=0.03
STOP_LOSS_PCT=0.05

# Estado local del simulador y registro de operaciones
STATE_DIR=state

# --- cTrader Open API (brokers como Fusion Markets; solo cuentas demo) ---
# 1) Crea un cTrader ID en id.ctrader.com y vincula tu cuenta demo del broker.
# 2) Registra una app en openapi.ctrader.com (espera a que Spotware la active) y copia sus claves.
# 3) python scripts/ctrader_token.py --url  -> abre el enlace, autoriza, y canjea el codigo:
#    python scripts/ctrader_token.py "<URL de redireccion con code=...>"
CTRADER_CLIENT_ID=
CTRADER_CLIENT_SECRET=
CTRADER_ACCOUNT_LOGIN=
CTRADER_DEMO=true
# Alternativa a state/ctrader_tokens.json (p.ej. en GitHub Actions):
CTRADER_REFRESH_TOKEN=
# Tope de exposicion nominal como multiplo del equity (1 = contado). El riesgo por operacion NO se apalanca.
EXPOSURE_LEVERAGE=1
